# ---- Required ----
# PostgreSQL connection string. Local dev: `docker compose up -d` at the repo root.
DATABASE_URL=postgresql://haya:haya_local_dev@localhost:5433/haya

# Secret used to sign session tokens. At least 32 characters; the server refuses to start otherwise.
# Generate one with: openssl rand -hex 32
JWT_SECRET=

# ---- Optional ----
NODE_ENV=development
PORT=5000
JWT_EXPIRES_IN=7d

# Comma-separated browser origins allowed to call the API (your Vercel URL in production).
FRONTEND_URL=http://localhost:5173

# Reverse proxies in front of Express. Render alone = 1; Vercel /api rewrite -> Render = 2.
TRUST_PROXY=1

# ---- Haya Insights (AI) ----
# Server-side only; never exposed to the browser. Without a key, the AI cards show
# "not configured" (demo accounts still get sample text and never call the API).
ANTHROPIC_API_KEY=
# Defaults to claude-opus-5-5.
ANTHROPIC_MODEL=

# Password for the seeded demo accounts (npm run db:seed). Default: HayaDemo#2026
DEMO_PASSWORD=
